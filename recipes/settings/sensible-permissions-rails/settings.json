{
  "permissions": {
    "allow": [
      "Bash(ruby --version)",
      "Bash(bundle --version)",
      "Bash(bundle install *)",
      "Bash(bundle exec *)",

      "Bash(bin/rails routes *)",
      "Bash(bin/rails db:seed)",

      "Bash(bin/rspec *)",
      "Bash(bin/rspec --fail-fast)",
      "Bash(timeout 600 bundle exec rspec --no-color)",

      "Bash(bin/rubocop)",
      "Bash(bin/rubocop *)",
      "Bash(timeout 60 bundle exec rubocop)",
      "Bash(timeout 60 bundle exec rubocop -A)",

      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git push *)",

      "Bash(gh pr *)"
    ]
  }
}
